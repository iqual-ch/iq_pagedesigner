{
  "name": "iqual/iq_pagedesigner",
  "description": "Metapackage for easy instalation of pagedesigner modules.",
  "type": "drupal-custom-module",
  "keywords": [
    "Drupal"
  ],
  "homepage": "https://github.com/iqual-ch/iq_pagedesigner",
  "support": {
    "issues": "https://github.com/iqual-ch/iq_pagedesigner/issues",
    "source": "https://github.com/iqual-ch/iq_pagedesigner"
  },
  "repositories": {
    "drupal/pagedesigner_favourite": {
      "type": "vcs",
      "url": "https://git.drupalcode.org/issue/pagedesigner_favourite-3520137.git"
    },
    "drupal/pagedesigner_effects": {
      "type": "vcs",
      "url": "https://git.drupalcode.org/issue/pagedesigner_effects-3438544.git"
    },
    "drupal/pagedesigner_parts": {
      "type": "vcs",
      "url": "https://git.drupalcode.org/issue/pagedesigner_parts-3438548.git"
    },
    "drupal/pagedesigner_responsive_images": {
      "type": "vcs",
      "url": "https://git.drupalcode.org/issue/pagedesigner_responsive_images-3542735.git"
    }
  },
  "require": {
    "php": "^8.1",
    "drupal/core": "^10.1 || ^11",
    "drupal/pagedesigner_effects": "dev-3438544-drupal-11-upgrade as 4.0.0",
    "drupal/pagedesigner": "4.x-dev",
    "drupal/pagedesigner_favourite": "dev-3520137-drupal-11-upgrade as 4.0.0",
    "drupal/pagedesigner_responsive_images": "dev-3542735-drupal-11 as 4.0.0",
    "drupal/pagedesigner_parts": "dev-3438548-drupal-11-upgrade as 4.0.0"
  },
  "config": {
    "preferred-install": {
      "drupal/pagedesigner_effects": "source",
      "drupal/pagedesigner_favourite": "source",
      "drupal/pagedesigner_parts": "source",
      "drupal/pagedesigner_responsive_images": "source"
    }
  }
}
